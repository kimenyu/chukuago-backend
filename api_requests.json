    "list_errands": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/errands?page=1&limit=20",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "note": "Returns only the authenticated client's errands."
    },

    "list_errands_by_status": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/errands?status=posted&page=1&limit=20",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "note": "Filter by status: draft, posted, bidding, assigned, in_progress, delivered, completed, cancelled, disputed, expired"
    },

    "get_errand_by_id": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>",
      "headers": {
        "Authorization": "Bearer <accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "note": "Replace <errand_id> with a UUID from create or list responses."
    },

    "update_errand": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>",
