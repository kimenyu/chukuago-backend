{
  "info": {
    "name": "ChukuaGo API",
    "description": "Complete test collection for the ChukuaGo Go backend. Run requests in order — auth first, then use the returned tokens for protected routes.",
    "base_url": "http://localhost:8080/api/v1",
    "notes": [
      "1. Start with AUTH section — run send-otp, then verify-otp to get tokens",
      "2. Copy accessToken from verify-otp response into the 'token' field of any protected request",
      "3. For runner routes, first register a runner account and complete KYC",
      "4. For admin routes, use an admin account token",
      "5. Replace all placeholder UUIDs (xxxxxxxx-...) with real IDs from previous responses"
    ]
  },

  "auth": {
    "send_otp_client": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/send-otp",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+254712345678",
        "role": "client"
      },
      "expected_status": 200,
      "note": "Sends a 6-digit OTP via Africa's Talking SMS. Check your phone or AT sandbox logs."
    },

    "send_otp_runner": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/send-otp",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+254798765432",
        "role": "runner"
      },
      "expected_status": 200
    },

    "verify_otp_client": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/verify-otp?role=client",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+254712345678",
        "otp": "482910"
      },
      "expected_status": 200,
      "note": "Replace 482910 with the real OTP from your SMS. Response contains accessToken and refreshToken.",
      "expected_response_shape": {
        "success": true,
        "data": {
          "accessToken": "<JWT — copy this for all protected requests>",
          "refreshToken": "<JWT — use for /auth/refresh>"
        }
      }
    },

    "verify_otp_runner": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/verify-otp?role=runner",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "phone": "+254798765432",
        "otp": "123456"
      },
      "expected_status": 200
    },

    "refresh_token": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/refresh",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "refreshToken": "<paste refreshToken from verify-otp response>"
      },
      "expected_status": 200,
      "note": "Returns a new accessToken + refreshToken pair. Old refresh token is invalidated."
    },

    "logout": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/auth/logout",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <accessToken>"
      },
      "body": {
        "refreshToken": "<paste refreshToken>"
      },
      "expected_status": 204
    }
  },

  "profile": {
    "get_profile": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/profile",
      "headers": {
        "Authorization": "Bearer <accessToken>"
      },
      "body": null,
      "expected_status": 200
    },

    "update_profile": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/profile",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <accessToken>"
      },
      "body": {
        "name": "Carol Mwangi",
        "email": "carol@example.com",
        "bio": "Busy professional in Westlands. Love having errands handled.",
        "profilePicture": "https://your-cloudinary-url.com/photo.jpg"
      },
      "expected_status": 200,
      "note": "All fields are optional. Send only what you want to change."
    },

    "update_location": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/profile/location",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <accessToken>"
      },
      "body": {
        "lat": -1.2741,
        "lng": 36.8119
      },
      "expected_status": 204,
      "note": "Coordinates above are Westlands, Nairobi. No response body on success."
    }
  },

  "runner_setup": {
    "submit_kyc": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/kyc",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "nationalIdFrontUrl": "https://your-cloudinary.com/uploads/kyc/id_front.jpg",
        "nationalIdBackUrl": "https://your-cloudinary.com/uploads/kyc/id_back.jpg",
        "selfieUrl": "https://your-cloudinary.com/uploads/kyc/selfie.jpg"
      },
      "expected_status": 202,
      "note": "Upload images to Cloudinary first to get the URLs, then submit them here. KYC review takes 24-48 hrs."
    },

    "get_kyc_status": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/runner/kyc/status",
      "headers": {
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "expected_response_shape": {
        "success": true,
        "data": {
          "status": "pending"
        }
      }
    },

    "set_availability_online": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/runner/availability",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "isAvailable": true
      },
      "expected_status": 204,
      "note": "Toggle to false to go offline."
    },

    "set_availability_offline": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/runner/availability",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "isAvailable": false
      },
      "expected_status": 204
    },

    "add_service_area_region": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/service-areas",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "regionId": "<uuid of Nairobi region from service_regions table>",
        "label": "Nairobi CBD & surroundings"
      },
      "expected_status": 201,
      "note": "Either regionId or label is required. Use regionId for pre-defined Kenyan counties."
    },

    "add_service_area_custom": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/service-areas",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "label": "Westlands, Parklands, Highridge"
      },
      "expected_status": 201
    },

    "remove_service_area": {
      "method": "DELETE",
      "url": "http://localhost:8080/api/v1/runner/service-areas/<service_area_id>",
      "headers": {
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": null,
      "expected_status": 204,
      "note": "Replace <service_area_id> with the UUID returned from add_service_area."
    }
  },

  "errands": {
    "create_errand_groceries": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": {
        "title": "Pick up groceries from Carrefour Karen",
        "description": "Need the following items: 2kg unga, 1L milk (Brookside), 500g butter, bread. Budget is flexible if items are slightly more.",
        "category": "groceries",
        "currency": "KES",
        "allowBids": true,
        "budgetMin": 300,
        "budgetMax": 600,
        "stops": [
          {
            "stopType": "pickup",
            "addressLabel": "Carrefour Karen",
            "addressText": "Carrefour Supermarket, Karen Shopping Centre, Karen Road, Nairobi",
            "lat": -1.3192,
            "lng": 36.7126,
            "instructions": "Main entrance. Items are for purchase, not pick up from someone."
          },
          {
            "stopType": "dropoff",
            "addressLabel": "Home",
            "addressText": "Karen Plains Estate, House 14B, Karen, Nairobi",
            "lat": -1.3248,
            "lng": 36.7089,
            "contactName": "Carol",
            "contactPhone": "+254712345678",
            "instructions": "Call when you arrive. Gate code is 1234."
          }
        ]
      },
      "expected_status": 201,
      "note": "Returns the created errand with id. Save this id for subsequent requests."
    },

    "create_errand_fixed_price": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": {
        "title": "Pay KPLC bill at Equity Bank Westlands",
        "description": "Pay electricity bill for account 0834992001. Amount is KES 4,500. Will M-Pesa the money to runner before they go.",
        "category": "bill_payment",
        "currency": "KES",
        "allowBids": false,
        "instantAccept": true,
        "fixedPrice": 250,
        "stops": [
          {
            "stopType": "pickup",
            "addressLabel": "My office",
            "addressText": "Delta Towers, Westlands, Nairobi",
            "lat": -1.2676,
            "lng": 36.8082,
            "contactName": "Carol",
            "contactPhone": "+254712345678",
            "instructions": "Come to reception on ground floor, I'll hand you the bill slip."
          },
          {
            "stopType": "dropoff",
            "addressLabel": "Equity Bank Westlands",
            "addressText": "Equity Bank, Ring Road Westlands, Nairobi",
            "lat": -1.2671,
            "lng": 36.8063,
            "instructions": "Pay at the teller counter. Get a receipt and bring it back to my office."
          }
        ]
      },
      "expected_status": 201
    },

