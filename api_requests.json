  "testing_order": {
    "description": "Recommended order to run a full end-to-end test flow",
    "steps": [
      "1.  auth.send_otp_client             → sends OTP to client phone",
      "2.  auth.verify_otp_client           → get client accessToken + refreshToken",
      "3.  auth.send_otp_runner             → sends OTP to runner phone",
      "4.  auth.verify_otp_runner           → get runner accessToken",
      "5.  profile.update_profile           → set client name",
      "6.  profile.update_location          → set client GPS",
      "7.  runner_setup.submit_kyc          → runner uploads docs",
      "8.  admin.list_pending_kyc           → admin sees pending KYC (need admin token first)",
      "9.  admin.approve_kyc               → admin approves runner",
      "10. runner_setup.set_availability_online → runner goes online",
      "11. runner_setup.add_service_area_custom → runner sets coverage zone",
      "12. errands.create_errand_groceries  → client posts errand",
      "13. runner_feed_and_offers.browse_feed_with_location → runner sees errand in feed",
      "14. runner_feed_and_offers.place_bid → runner bids",
      "15. runner_feed_and_offers.list_offers_on_errand → client views bids",
      "16. runner_feed_and_offers.accept_offer → client accepts runner",
      "17. errand_status_lifecycle.runner_start_errand → runner starts",
      "18. chat.send_text_message           → coordinate via chat",
      "19. errand_status_lifecycle.runner_mark_delivered → runner at dropoff",
      "20. delivery_otp.generate_delivery_otp → client generates code",
      "21. delivery_otp.verify_delivery_otp → runner enters code → errand completed",
      "22. reviews.create_review_client_rates_runner → client rates runner",
      "23. reviews.create_review_runner_rates_client → runner rates client",
      "24. auth.refresh_token               → rotate tokens",
      "25. auth.logout                      → end session"
    ]
  }
}