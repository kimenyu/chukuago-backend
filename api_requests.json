    "list_reviews": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/reviews",
      "headers": {
        "Authorization": "Bearer <accessToken>"
      },
      "body": null,
      "expected_status": 200
