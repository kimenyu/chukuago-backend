        "addressText": "Naivas Supermarket, Westgate Mall, Westlands, Nairobi",
        "lat": -1.2575,
        "lng": 36.7999,
        "instructions": "Also pick up 1 litre of Brookside milk from Naivas on the way."
      },
      "expected_status": 201
