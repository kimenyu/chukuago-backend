    "cancel_errand": {
      "method": "DELETE",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 204,
      "note": "Only works if the errand has not been assigned yet. Returns 409 ERRAND_NOT_CANCELLABLE if runner is already assigned."
    }
  },

  "runner_feed_and_offers": {
    "browse_feed_no_location": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/errands/feed",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "page": 1,
        "limit": 20
      },
      "expected_status": 200,
      "note": "Returns all available errands. KYC must be approved to access this endpoint."
    },

    "browse_feed_with_location": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/errands/feed",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "lat": -1.2741,
        "lng": 36.8119,
        "radiusKm": 10,
        "page": 1,
        "limit": 20
      },
      "expected_status": 200,
      "note": "Coordinates are Westlands. Returns errands within 10km using PostGIS ST_DWithin."
    },

    "browse_feed_with_category": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/errands/feed",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "lat": -1.2741,
        "lng": 36.8119,
        "radiusKm": 15,
        "category": "delivery",
        "page": 1,
        "limit": 20
      },
      "expected_status": 200
    },

    "place_bid": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/errands/<errand_id>/offers",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "amount": 450,
        "etaMinutes": 25,
        "message": "I'm in Westlands right now, can be there in 20 minutes. I have a motorbike."
      },
      "expected_status": 201,
      "note": "Replace <errand_id> with an errand that has allowBids: true and status posted or bidding."
    },

    "place_bid_minimal": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/runner/errands/<errand_id>/offers",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "amount": 300
      },
      "expected_status": 201,
      "note": "Only amount is required."
    },

    "list_offers_on_errand": {
      "method": "GET",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/offers",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "note": "Client sees all bids on their errand, with runner name and rating."
    },

    "accept_offer": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/offers/<offer_id>/accept",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "note": "Atomically accepts this offer and rejects all others. Errand status moves to assigned. Uses SELECT FOR UPDATE to prevent race conditions."
    }
  },

  "errand_status_lifecycle": {
    "runner_start_errand": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/runner/errands/<errand_id>/status",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "status": "in_progress",
        "notes": "On my way to the pickup location now."
      },
      "expected_status": 204,
      "note": "Advances from assigned → in_progress. Runner must be the assigned runner."
    },

    "runner_mark_delivered": {
      "method": "PATCH",
      "url": "http://localhost:8080/api/v1/runner/errands/<errand_id>/status",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "status": "delivered",
        "notes": "At the dropoff location. Waiting for client to generate delivery code."
      },
      "expected_status": 204,
      "note": "Advances from in_progress → delivered. Client must now generate OTP to confirm."
    }
  },

  "delivery_otp": {
    "generate_delivery_otp": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/delivery-otp",
      "headers": {
        "Authorization": "Bearer <client_accessToken>"
      },
      "body": null,
      "expected_status": 200,
      "expected_response_shape": {
        "success": true,
        "data": {
          "otp": "482910",
          "expiresAt": "2025-08-01T14:25:00Z"
        }
      },
      "note": "Errand must be in delivered status. Client shares the 6-digit code verbally with the runner. Valid for 10 minutes. Raw OTP is NEVER stored — only SHA-256 hash."
    },

    "verify_delivery_otp": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/verify-delivery",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "otp": "482910"
      },
      "expected_status": 200,
      "note": "Runner enters the code client gave them. On success: errand → completed. Max 3 attempts before OTP locks. Both parties receive push notifications."
    },

    "verify_delivery_wrong_otp": {
      "method": "POST",
      "url": "http://localhost:8080/api/v1/errands/<errand_id>/verify-delivery",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <runner_accessToken>"
      },
      "body": {
        "otp": "000000"
      },
      "expected_status": 400,
      "note": "Tests the wrong-code path. Should return OTP_INVALID error."
    }
  },

